{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^https://chat.daza.ar"
    },
    {
      "pattern": "^https://staging.chat.daza.ar"
    },
    {
      "pattern": "^http://192\\.168\\."
    },
    {
      "pattern": "^https://github\\.com/roofsonfire/chat/settings/"
    },
    {
      "pattern": "^https://github\\.com/roofsonfire/chat/discussions"
    },
    {
      "pattern": "^https://chat-staging-.*\\.run\\.app"
    },
    {
      "comment": "Ignore problematic external docs (404s or redirects)",
      "pattern": "https://nextjs\\.org/docs/advanced-features/debugging"
    },
    {
      "pattern": "https://nodejs\\.org/en/docs/guides/error-handling"
    },
    {
      "pattern": "https://cloud\\.google\\.com/vertex-ai/docs/model-garden/explore-models"
    },
    {
      "pattern": "https://ai\\.google\\.dev/gemini-api/docs/image-generation"
    },
    {
      "comment": "Google Cloud Console causes header overflow errors in link checker",
      "pattern": "https://console\\.cloud\\.google\\.com/vertex-ai/"
    },
    {
      "comment": "Gemini CLI documentation pages that return 404",
      "pattern": "https://github\\.com/google/generative-ai-docs/tree/main/demos/gemini-cli"
    },
    {
      "comment": "Gemini API CLI docs that return 404",
      "pattern": "https://ai\\.google\\.dev/gemini-api/docs/cli"
    },
    {
      "comment": "React discussions page that returns 404",
      "pattern": "https://github\\.com/facebook/react/discussions"
    },
    {
      "comment": "Localhost URLs used in documentation examples",
      "pattern": "^http://127\\.0\\.0\\.1:"
    },
    {
      "comment": "Mailto links (package version references incorrectly formatted)",
      "pattern": "^mailto:"
    },
    {
      "comment": "Relative docs/ paths in archive that don't resolve correctly",
      "pattern": "^docs/(PROJECT-NAVIGATION|USER-MANAGEMENT|CONTRIBUTING-DOCS|PROJECT-STATUS|OAUTH-SETUP|features/MODEL-SELECTION)\\.md$"
    },
    {
      "comment": "LICENSE file outside docs",
      "pattern": "\\.\\./(LICENSE|CHANGELOG\\.md)$"
    },
    {
      "comment": "Pull request template",
      "pattern": "\\.github/PULL_REQUEST_TEMPLATE\\.md$"
    },
    {
      "comment": "Ignore links to .github/patterns/ - these exist but are outside docs/",
      "pattern": "^\\.github/patterns/"
    },
    {
      "comment": "Ignore links to files outside docs/ directory",
      "pattern": "^\\.\\./(tests|src|scripts|.github)/"
    },
    {
      "comment": "Ignore session summary files that were moved",
      "pattern": "SESSION-[0-9]+-SUMMARY\\.md$"
    },
    {
      "comment": "Ignore security files that were moved to security/ subdirectory",
      "pattern": "SECURITY-(ASSESSMENT|REMEDIATION|FINDINGS).*\\.md$"
    },
    {
      "comment": "Ignore deployment files in wrong path",
      "pattern": "DEPLOYMENT-TRANSITION-PLAN\\.md$"
    },
    {
      "comment": "Ignore archive migration files",
      "pattern": "migration/(nextjs|tailwind)-.*\\.md$"
    },
    {
      "comment": "Ignore non-existent style/writing guides",
      "pattern": "(STYLE|WRITING)-GUIDE\\.md$"
    }
  ],
  "replacementPatterns": [],
  "httpHeaders": [
    {
      "urls": ["https://github.com"],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 403]
}
