{
  "version": "0.2.0",
  "configurations": [
    // Next.js Development Debugging
    {
      "name": "🚀 Debug Next.js (Dev Server)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev", "--turbopack"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "NODE_OPTIONS": "--inspect"
      },
      "serverReadyAction": {
        "pattern": "ready - started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "development",
        "order": 1
      }
    },

    // Client-Side Chrome Debugging
    {
      "name": "🌐 Debug Next.js (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack://./src/*": "${webRoot}/src/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///./~/*": "${webRoot}/node_modules/*"
      },
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--disable-web-security",
        "--disable-features=VizDisplayCompositor"
      ],
      "presentation": {
        "hidden": false,
        "group": "development",
        "order": 2
      }
    },

    // API Routes Debugging
    {
      "name": "🔧 Debug API Routes",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev", "--turbopack"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "next:*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/.next/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/src/app/api/**",
        "${workspaceFolder}/src/lib/**"
      ],
      "presentation": {
        "hidden": false,
        "group": "development",
        "order": 3
      }
    },

    // Attach to Running Next.js Process
    {
      "name": "🔗 Attach to Next.js",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "development",
        "order": 4
      }
    },

    // Unit Test Debugging (Vitest)
    {
      "name": "🧪 Debug Unit Tests (Vitest)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["--inspect-brk", "--no-coverage", "--reporter=verbose"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "presentation": {
        "hidden": false,
        "group": "testing",
        "order": 1
      }
    },

    // Debug Specific Test File
    {
      "name": "🎯 Debug Current Test File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": [
        "--inspect-brk",
        "--no-coverage",
        "--reporter=verbose",
        "${relativeFile}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "presentation": {
        "hidden": false,
        "group": "testing",
        "order": 2
      }
    },

    // E2E Test Debugging (Playwright)
    {
      "name": "🎭 Debug E2E Tests (Playwright)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/playwright",
      "args": ["test", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test",
        "PWDEBUG": "1"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "testing",
        "order": 3
      }
    },

    // Debug E2E Test (Current File)
    {
      "name": "🎯 Debug Current E2E Test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/playwright",
      "args": ["test", "--debug", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test",
        "PWDEBUG": "1"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "testing",
        "order": 4
      }
    },

    // Production Build Debugging
    {
      "name": "🏭 Debug Production Build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["start"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "production"
      },
      "preLaunchTask": "🔨 Build for Production",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "production",
        "order": 1
      }
    },

    // Debug Utility Scripts
    {
      "name": "🔧 Debug Node Script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/${input:scriptPath}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "utilities",
        "order": 1
      }
    },

    // Debug Password Hash Script
    {
      "name": "🔐 Debug Password Hash Script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/utils/hash-password.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "utilities",
        "order": 2
      }
    },

    // Debug TypeScript files directly
    {
      "name": "📝 Debug TypeScript File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": false,
        "group": "utilities",
        "order": 3
      }
    }
  ],
  "compounds": [
    // Full Stack Debugging
    {
      "name": "🔥 Debug Full Stack",
      "configurations": [
        "🚀 Debug Next.js (Dev Server)",
        "🌐 Debug Next.js (Chrome)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "compound",
        "order": 1
      }
    },

    // Complete Testing Suite
    {
      "name": "🧪 Debug All Tests",
      "configurations": [
        "🧪 Debug Unit Tests (Vitest)",
        "🎭 Debug E2E Tests (Playwright)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "compound",
        "order": 2
      }
    }
  ],
  "inputs": [
    {
      "id": "scriptPath",
      "description": "Path to the Node.js script to debug",
      "default": "scripts/",
      "type": "promptString"
    }
  ]
}
