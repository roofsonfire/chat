# Test Environment Configuration
# Used by Vitest for running tests

# NextAuth Configuration
NEXTAUTH_SECRET=test-secret-key-at-least-32-characters-long-for-testing-purposes
NEXTAUTH_URL=http://localhost:3000

# User Authentication
AUTH_USER_EMAIL=test@example.com
AUTH_USER_PASSWORD_HASH=$2b$10$abcdefghijklmnopqrstuvwxyz1234567890ABCDEFGHIJKLMNOPQ
ALLOWED_EMAILS=test@example.com,test2@example.com

# Google Cloud Vertex AI
GOOGLE_PROJECT_ID=test-project-id
GOOGLE_LOCATION=us-central1
GOOGLE_VERTEX_AI_MODEL_ID=gemini-1.5-flash-002

# Google OAuth
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret

# Environment
NODE_ENV=test
