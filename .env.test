# ========================================
# Test Environment Variables for E2E Tests
# ========================================
# These are SAFE to commit as they contain NO production secrets.
# Used by Playwright tests via @next/env loader.
#
# WARNING: Do NOT use these values in production!
# ========================================

# NextAuth Configuration
NEXTAUTH_SECRET="test-secret-for-e2e-tests-only-not-for-production-use"
NEXTAUTH_URL="http://localhost:3000"

# Test User Credentials
# Email: test@example.com
# Password: test123 (hashed below)
AUTH_USER_EMAIL="test@example.com"
AUTH_USER_PASSWORD_HASH="\$2b\$10\$4qGWCHsaGWixW2lgvn73peWQNHxAz.PM5PJWnjmUBgtK8QbgR3Xgi"
NEXT_PUBLIC_TEST_EMAIL="test@example.com"
NEXT_PUBLIC_TEST_PASSWORD="test123"

# Google Cloud / Vertex AI Mock Configuration
# These values are used to satisfy validation but won't make actual API calls in tests
GOOGLE_PROJECT_ID="test-project-id-for-e2e-testing"
GOOGLE_LOCATION="us-central1"
GOOGLE_VERTEX_AI_MODEL_ID="gemini-2.5-flash-image"

# Testing configuration
DISABLE_RATE_LIMIT="true"
SKIP_VERTEX_MODEL_VALIDATION="true"
