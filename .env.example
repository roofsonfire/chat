# Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# NEXTAUTH CONFIGURATION (Required)
# =============================================================================

# NextAuth.js secret key for JWT signing and encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Application URL for NextAuth.js callbacks
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# USER AUTHENTICATION (Required)
# =============================================================================

# Authorized user email address (for credentials login - deprecated, use ALLOWED_EMAILS)
AUTH_USER_EMAIL=your-email@example.com

# Bcrypt hashed password for the authorized user
# Generate with: node scripts/utils/hash-password.js
AUTH_USER_PASSWORD_HASH=your-bcrypt-hash-here

# Allowed email addresses for OAuth login (comma-separated)
# These emails will be able to sign in via Google OAuth
# Example: ALLOWED_EMAILS=user1@example.com,user2@example.com,user3@example.com
ALLOWED_EMAILS=your-email@example.com,invited-user@example.com

# =============================================================================
# GOOGLE CLOUD VERTEX AI (Required)
# =============================================================================

# Google Cloud Project ID where Vertex AI is enabled
GOOGLE_PROJECT_ID=your-google-project-id

# Google Cloud region for Vertex AI (e.g., us-central1, us-west1)
GOOGLE_LOCATION=us-central1

# Vertex AI model ID to use for chat
# Available models: gemini-1.5-flash-002, gemini-1.5-pro-002, gemini-2.0-flash-exp
GOOGLE_VERTEX_AI_MODEL_ID=gemini-1.5-flash-002

# ============================================================================
# GOOGLE OAUTH (Required)
# ============================================================================
# OAuth Client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=your-google-client-id

# OAuth Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# OPTIONAL: PERFORMANCE & MONITORING
# =============================================================================

# Environment identifier for logging and monitoring
NODE_ENV=development

# Enable/disable performance monitoring (true/false)
# ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# OPTIONAL: RATE LIMITING
# =============================================================================

# Rate limiting is handled in-memory by default
# For production with multiple servers, consider Redis-based rate limiting
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file:
#    cp .env.example .env.local

# 2. Generate NextAuth secret:
#    openssl rand -base64 32

# 3. Set up Google Cloud:
#    - Create a GCP project
#    - Enable Vertex AI API
#    - Set up authentication (gcloud auth application-default login)

# 4. Generate password hash:
#    node scripts/utils/hash-password.js

# 5. Update all values above with your configuration

# 6. Verify setup:
#    npm run dev

# For detailed setup instructions, see: docs/DEVELOPMENT.md