    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky",
    "hash-password": "node scripts/hash-password.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
